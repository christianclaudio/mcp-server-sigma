{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.christianclaudio/sigma",
  "title": "mcp-server-sigma",
  "description": "MCP server for Sigma Computing. Provision dashboards, build models, and automate cloud analytics.",
  "repository": {
    "url": "https://github.com/christianclaudio/mcp-server-sigma",
    "source": "github"
  },
  "version": "1.0.6",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mcp-server-sigma",
      "version": "1.0.6",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SIGMA_CLIENT_ID",
          "description": "Your Sigma API client ID",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "SIGMA_CLIENT_SECRET",
          "description": "Your Sigma API client secret",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "SIGMA_API_BASE_URL",
          "description": "Region-specific Sigma API host URL (e.g. https://api.us-a.aws.sigmacomputing.com)",
          "isRequired": true,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
